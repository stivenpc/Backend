# ==============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO - SISTEMA DE MERMA DE FUNDICIÓN
# ==============================================================================
# Copie este archivo como .env y defina los valores correspondientes para su entorno.
# NUNCA suba el archivo .env real con credenciales al control de versiones.

# Clave secreta de Django (en producción debe ser una cadena aleatoria criptográficamente segura)
SECRET_KEY=django-insecure-cambiar-esta-clave-en-produccion-por-una-cadena-larga-y-aleatoria

# Modo de depuración (True para desarrollo, False para producción)
DEBUG=True

# Hosts permitidos separados por comas
ALLOWED_HOSTS=127.0.0.1,localhost

# Conexión a Base de Datos
# Formato: sqlite:///ruta/al/archivo.sqlite3 o postgres://user:password@host:port/dbname
DATABASE_URL=sqlite:///db.sqlite3
